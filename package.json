{
  "name": "dsh-verification-receipt",
  "description": "Privacy-minimal heuristic per-turn execution summaries for DeepSeek Harness",
  "version": "0.1.0",
  "license": "MIT",
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "verification",
    "observability",
    "privacy"
  ],
  "homepage": "https://github.com/030611/dsh-verification-receipt#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/030611/dsh-verification-receipt.git"
  },
  "bugs": {
    "url": "https://github.com/030611/dsh-verification-receipt/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "dsh.plugin.json",
    "README.md",
    "README.zh.md",
    "LICENSE",
    "SECURITY.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dshCompatibility": {
    "testedHead": "47f943859bef60e4160492346772ded9b24f765a",
    "peersAtTestedHead": {
      "@deepseek-ai/cordis": "4.0.1",
      "@deepseek-ai/dsh-session": "0.1.0-rc.5",
      "@deepseek-ai/schemastery": "3.18.1"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && esbuild src/index.ts --bundle --packages=external --platform=node --format=esm --target=node22 --outfile=lib/index.js",
    "prepare": "pnpm run build",
    "publint": "publint",
    "performance:smoke": "node scripts/performance-smoke.mjs",
    "release:smoke": "node scripts/release-smoke.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "pnpm run typecheck && pnpm run test && pnpm run build && pnpm run publint"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-session": ">=0.1.0-rc.5 <0.1.0",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-session": {
      "optional": true
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-llm": "0.1.0-rc.6",
    "@deepseek-ai/dsh-session": "0.1.0-rc.6",
    "@deepseek-ai/schemastery": "3.18.1",
    "@types/node": "^24.0.0",
    "esbuild": "0.28.2",
    "publint": "^0.3.12",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
